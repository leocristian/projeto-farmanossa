    pn_form: TPanel;
    input_login: TEdit;
    input_senha: TEdit;
    label_nome: TLabel;
    btn_ajuda: TSpeedButton;
    label_senha: TLabel;
    Label1: TLabel;
    SpeedButton1: TSpeedButton;
    SpeedButton2: TSpeedButton;
    procedure SpeedButton2Click(Sender: TObject);
