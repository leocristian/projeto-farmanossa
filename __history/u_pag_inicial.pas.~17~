unit u_pag_inicial;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.ExtCtrls, Vcl.Menus,
  Vcl.Imaging.pngimage;

type
  Tpag_inicial = class(TForm)
    mn_principal: TMainMenu;
    mn_cadastro: TMenuItem;
    mn_estoque: TMenuItem;
    pn_principal: TPanel;
    cad_operadores: TMenuItem;
    cad_produtos: TMenuItem;
    cad_locais: TMenuItem;
    N1000EntradadeMercadorias1: TMenuItem;
    N1100SadadeMercadorias1: TMenuItem;
    N1200ConsultarEstoque1: TMenuItem;
    RELRelatriosdeEstoque1: TMenuItem;
    N1: TMenuItem;
    Panel1: TPanel;
    Label1: TLabel;
    Label2: TLabel;
    procedure FormShow(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  pag_inicial: Tpag_inicial;

implementation

{$R *.dfm}

uses u_pag_login;

procedure ChamaForm(fClass:TFormClass; Form:TForm);
begin
  try
    Application.CreateForm(fClass,Form);
    Form.ShowModal;
  Finally
    Form.Release;
    Form:=nil;
  end;
end;

procedure Tpag_inicial.FormShow(Sender: TObject);
begin
  ChamaForm(Tpag_login, pag_login);
end;

end.
