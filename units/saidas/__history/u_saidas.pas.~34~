    FrameGrid1: TFrameGrid;
    gridSaidas: TcxGrid;
    gridSaidasDBTableView1: TcxGridDBTableView;
    gridSaidasLevel1: TcxGridLevel;
    sai_codigo: TcxGridDBColumn;
    sai_produto: TcxGridDBColumn;
