unit u_detalharSaida;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.ExtCtrls, Vcl.Buttons, Vcl.StdCtrls,
  Vcl.NumberBox, cxGraphics, cxControls, cxLookAndFeels, cxLookAndFeelPainters,
  cxContainer, cxEdit, Vcl.ComCtrls, dxCore, cxDateUtils, cxTextEdit,
  cxMaskEdit, cxDropDownEdit, cxCalendar, fm_buttons, System.ImageList,
  Vcl.ImgList;

type
  TDetalharSaidaForm = class(TForm)
    pn_form: TPanel;
    Label1: TLabel;
    Label2: TLabel;
    Label3: TLabel;
    SpeedButton1: TSpeedButton;
    SpeedButton2: TSpeedButton;
    Label7: TLabel;
    CodEdit: TEdit;
    CodProdEdit: TEdit;
    DescProdEdit: TEdit;
    DescLocalEdit: TEdit;
    CodLocalEdit: TEdit;
    QtdProdEdit: TNumberBox;
    LimparProd: TBitBtn;
    LimparLocal: TBitBtn;
    pn_datas: TPanel;
    Label6: TLabel;
    Label5: TLabel;
    DtVencimentoEdit: TcxDateEdit;
    DtFabricacaoEdit: TcxDateEdit;
    Label4: TLabel;
    LoteEdit: TEdit;
    FrameButtons1: TFrameButtons;
    ImageList1: TImageList;
    procedure FormShow(Sender: TObject);
    procedure FrameButtons1CancelarBtnClick(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  DetalharSaidaForm: TDetalharSaidaForm;

implementation

{$R *.dfm}

procedure TDetalharSaidaForm.FormShow(Sender: TObject);
begin
  if FrameButtons1.ModoEdit.Text = 'V' then
  begin
    pn_form.Enabled := False;
    pn_datas.Enabled := False;
    FrameButtons1.SalvarBtn.Visible := False;
    FrameButtons1.CancelarBtn.Caption := 'Fechar';
  end;
end;

procedure TDetalharSaidaForm.FrameButtons1CancelarBtnClick(Sender: TObject);
begin
  Close;
end;

end.
