  tb_saidas.ParamByName('dataInicial').Value := DataInicialEdit.Date;
  tb_saidas.ParamByName('dataFinal').Value := DataFinalEdit.Date;
  tb_saidas.ParamByName('codigoInicial').Value := CodInicialEdit.Value;
  tb_saidas.ParamByName('codigoFinal').Value := CodFinalEdit.Value;

  ds_saidas.DataSet := tb_saidas;

  tb_saidas.Open;

end;

