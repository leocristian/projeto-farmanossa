procedure TFormSaida.FormShow(Sender: TObject);
begin
  if ModoEdit.Text = 'N' then
  begin
    pn_form.Enabled := true;
    LimparInputs(self);
    QtdProdEdit.Value := 0;
    CodProdEdit.SetFocus;
    CodEdit.Text := '0000';
    ModoEdit.Text := 'N';
    SelecionaLoteForm.Close;
    ConfirmarBtn.Font.Color := clRed;
  end;
end;

