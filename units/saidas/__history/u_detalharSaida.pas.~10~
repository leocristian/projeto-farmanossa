unit u_detalharSaida;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.ExtCtrls, Vcl.Buttons, Vcl.StdCtrls,
  Vcl.NumberBox, cxGraphics, cxControls, cxLookAndFeels, cxLookAndFeelPainters,
  cxContainer, cxEdit, Vcl.ComCtrls, dxCore, cxDateUtils, cxTextEdit,
  cxMaskEdit, cxDropDownEdit, cxCalendar, fm_buttons, System.ImageList,
  Vcl.ImgList, Uni;

type
  TDetalharSaidaForm = class(TForm)
    pn_form: TPanel;
    Label1: TLabel;
    Label2: TLabel;
    Label3: TLabel;
    SpeedButton1: TSpeedButton;
    SpeedButton2: TSpeedButton;
    Label7: TLabel;
    CodEdit: TEdit;
    CodProdEdit: TEdit;
    DescProdEdit: TEdit;
    DescLocalEdit: TEdit;
    CodLocalEdit: TEdit;
    QtdProdEdit: TNumberBox;
    LimparProd: TBitBtn;
    LimparLocal: TBitBtn;
    pn_datas: TPanel;
    Label6: TLabel;
    Label5: TLabel;
    DtVencimentoEdit: TcxDateEdit;
    DtFabricacaoEdit: TcxDateEdit;
    Label4: TLabel;
    LoteEdit: TEdit;
    FrameButtons1: TFrameButtons;
    ImageList1: TImageList;
    procedure FormShow(Sender: TObject);
    procedure FrameButtons1CancelarBtnClick(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  DetalharSaidaForm: TDetalharSaidaForm;

implementation

{$R *.dfm}

uses u_dm1, u_saidas;

procedure TDetalharSaidaForm.FormShow(Sender: TObject);
var
  q1: TUniQuery;
  indexSaida, codSaida: Integer;

begin
  if (FrameButtons1.ModoEdit.Text = 'V') or (FrameButtons1.ModoEdit.Text = 'A') then
  begin

    indexSaida := PagSaidas.gridSaidasDBTableView1.DataController.GetSelectedRowIndex(0);
    codSaida := PagSaidas.gridSaidasDBTableView1.ViewData.Records[indexSaida].Values[0];

    try
      q1 := TUniQuery.Create(q1);
      q1.Connection := dm1.con1;


      q1.SQL.clear;
      q1.SQL.Add('select s.sai_codigo, s.sai_produto, p.prod_descricao, s.sai_local,');
      q1.SQL.Add('l.loc_descricao, s.sai_lote, lotes.lote_dtfabricacao, lotes.lote_dtvencimento, s.sai_quantidade');
      q1.SQL.Add(' from tb_produtos as p');
      q1.SQL.Add('inner join tb_saidas as s');
      q1.SQL.Add('on ent_produto = prod_codigo');
      q1.SQL.Add('inner join tb_locais_estoque as l');
      q1.SQL.Add('on loc_codigo = ent_local');
      q1.SQL.Add('inner join tb_lotes as lotes');
      q1.SQL.Add('on lote_codigo = ent_lote');
      q1.SQL.Add('where ent_codigo = :codigo');

      q1.Open;

      CodEdit.Text := q1.FieldByName('sai_codigo').Value;
      CodProdEdit.Text := q1.FieldByName('sai_produto').Value;
      CodLocalEdit.Text := q1.FieldByName('sai_local').Value;

      DescProdEdit.Text := q1.FieldByName('prod_descricao').Value;
      DescLocalEdit.Text := q1.FieldByName('loc_descricao').Value;

      DtFabricacaoEdit.Date :=  q1.FieldByName('lote_dtfabricacao').Value;
      DtVencimentoEdit.Date :=  q1.FieldByName('lote_dtvencimento').Value;

      LoteEdit.Text := q1.FieldByName('sai_lote').Value;
      QtdProdEdit.Text := q1.FieldByName('sai_quantidade').Value;

    finally
      q1.Close;
      FreeAndNil(q1);
    end;

    if FrameButtons1.ModoEdit.Text = 'V' then
    begin
      pn_form.Enabled := False;
      pn_datas.Enabled := False;
      FrameButtons1.SalvarBtn.Visible := False;
      FrameButtons1.CancelarBtn.Caption := 'Fechar';
    end;
  end;
  
end;

procedure TDetalharSaidaForm.FrameButtons1CancelarBtnClick(Sender: TObject);
begin
  Close;
end;

end.
