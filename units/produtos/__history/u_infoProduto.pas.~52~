unit u_infoProduto;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.ExtCtrls, Uni,
  fm_buttons;

type
  TFormProduto = class(TForm)
    pn_form: TPanel;
    Label1: TLabel;
    Label2: TLabel;
    Label5: TLabel;
    Label3: TLabel;
    Label4: TLabel;
    CodEdit: TEdit;
    DescricaoEdit: TEdit;
    EstNegativoBox: TComboBox;
    StatusSaiBox: TComboBox;
    FrameButtons: TFrameButtons;
    Label6: TLabel;
    StatusProdBox: TComboBox;
    StatusEntBox: TComboBox;
    edc_cod: TEdit;
    procedure FormShow(Sender: TObject);
    procedure SalvarBtnClick(Sender: TObject);
    procedure CancelarBtnClick(Sender: TObject);
    procedure FormKeyPress(Sender: TObject; var Key: Char);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  FormProduto: TFormProduto;

implementation

{$R *.dfm}

uses u_controleForm, u_dm1, u_produtos;

procedure TFormProduto.CancelarBtnClick(Sender: TObject);
begin
  close;
end;

procedure TFormProduto.FormKeyPress(Sender: TObject; var Key: Char);
begin
  if Key = #13 then
  begin
    Key := #0;
    Perform(wm_nextdlgctl, 0, 0);
  end
  else if key = #27 then close;
end;

procedure TFormProduto.FormShow(Sender: TObject);
begin
  if (FrameButtons.ModoEdit.Text = 'V') and (FrameButtons.ModoEdit.Text = 'A') then
  begin
    try
      dm1.q1.SQL.Text := 'select * from tb_produtos where prod_codigo = :codigo';
      dm1.q1.ParamByName('codigo').Value := StrToInt(edc_cod.Text);

      dm1.q1.Open;

      CodEdit.Text := dm1.q1.FieldByName('prod_codigo').Value;
      DescricaoEdit.Text := dm1.q1.FieldByName('prod_descricao').Value;

      EstNegativoBox.ItemIndex := EstNegativoBox.items.IndexOf(dm1.q1.FieldByName('prod_estoque_negativo').Value);
      StatusProdBox.ItemIndex := StatusProdBox.Items.IndexOf(dm1.q1.FieldByName('prod_status').Value);
      StatusEntBox.ItemIndex := StatusEntBox.items.IndexOf(dm1.q1.FieldByName('prod_status_entrada').Value);
      StatusSaiBox.ItemIndex := StatusSaiBox.items.IndexOf(dm1.q1.FieldByName('prod_status_saida').Value);

    finally
      dm1.q1.Close;
    end;

    if FrameButtons.ModoEdit.Text = 'V' then
    begin
      Caption := 'Exibir Produto';
      pn_form.Enabled := False;
      FrameButtons.SalvarBtn.Visible := False;
      CodEdit.Text := '0000';
    end
    else if FrameButtons.ModoEdit.Text = 'A' then
    begin
      Caption := 'Alterar Produto';
      pn_form.Enabled := True;
      DescricaoEdit.SetFocus;
      FrameButtons.SalvarBtn.Visible := True;         
    end;
  end
  else if FrameButtons.ModoEdit.Text = 'N' then
  begin
    Caption := 'Incluir Produto';
    pn_form.Enabled := True;
    CodEdit.Text := '00';

    DescricaoEdit.SetFocus;
    DescricaoEdit.Clear;
    FrameButtons.SalvarBtn.Visible := True;
    EstNegativoBox.ItemIndex := 0;
    StatusEntBox.ItemIndex := 0;
    StatusSaiBox.ItemIndex := 0;
    StatusProdBox.ItemIndex := 0;
  end;
end;

procedure TFormProduto.SalvarBtnClick(Sender: TObject);
var
  msg_confirma: String;
  prod_codigo: Integer;

begin
  if DescricaoEdit.Text = '' then
  begin
    Aviso('Preencha todos os campos!');
    DescricaoEdit.SetFocus;
    exit;
  end;

  try
    if FrameButtons.ModoEdit.Text = 'N' then
    begin
      dm1.q1.SQL.Text := 'select nextval(''tb_produtos_cod_seq'') as prod_codigo';

      dm1.q1.Open;
      prod_codigo := dm1.q1.FieldByName('prod_codigo').Value;
      dm1.q1.Close;

      dm1.q1.SQL.Clear;
      dm1.q1.SQL.Add('insert into tb_produtos values ');
      dm1.q1.SQL.Add('(:prod_codigo, :prod_descricao, :prod_est_neg, :prod_status_entrada, :prod_status_saida, :prod_status)');

      dm1.q1.ParamByName('prod_codigo').Value := prod_codigo;
      msg_confirma := 'Confirmar inclusão do produto?';
    end
    else if FrameButtons.ModoEdit.Text = 'A' then
    begin
      dm1.q1.SQL.Clear;
      dm1.q1.SQL.Add('update tb_produtos set ');
      dm1.q1.SQL.Add('prod_descricao = :prod_descricao, prod_estoque_negativo = :prod_est_neg, prod_status = :prod_status, ');
      dm1.q1.SQL.Add('prod_status_entrada = :prod_status_entrada, prod_status_saida = :prod_status_saida');
      dm1.q1.SQL.Add(' where prod_codigo = :prod_codigo');
      dm1.q1.ParamByName('prod_codigo').Value := CodEdit.Text;
      msg_confirma := 'Salvar alterações?';
    end;

    dm1.q1.ParamByName('prod_descricao').Value := DescricaoEdit.Text;
    dm1.q1.ParamByName('prod_est_neg').Value := EstNegativoBox.Text;
    dm1.q1.ParamByName('prod_status').Value := StatusProdBox.Text;
    dm1.q1.ParamByName('prod_status_entrada').Value := StatusEntBox.Text;
    dm1.q1.ParamByName('prod_status_saida').Value := StatusSaiBox.Text;

    if Confirma(msg_confirma) then
    try
      dm1.q1.ExecSQL;
      Mensagem('Operação concluída!');
      PagProdutos.gridProdutosDBTableView1.DataController.RefreshExternalData;
      Close;
    except on e:exception do
        Erro('Erro: ' + #13 + e.Message);
    end;
  finally
    dm1.q1.Close;
  end;
end;

end.
