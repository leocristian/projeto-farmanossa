unit fm_filtroDataCod;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes,
  Vcl.Graphics, Vcl.Controls, Vcl.Forms, Vcl.Dialogs, cxGraphics, cxControls,
  cxLookAndFeels, cxLookAndFeelPainters, cxContainer, cxEdit, Vcl.ComCtrls,
  dxCore, cxDateUtils, Vcl.Buttons, Vcl.StdCtrls, Vcl.NumberBox, cxTextEdit,
  cxMaskEdit, cxDropDownEdit, cxCalendar, fr_estilo, Vcl.ExtCtrls,
  System.ImageList, Vcl.ImgList;

type
  TFiltroDataCod = class(TFrame)
    pn_busca: TPanel;
    FrameGrid2: TFrameGrid;
    dataBox: TGroupBox;
    Label1: TLabel;
    Label2: TLabel;
    LimparDatasBtn: TButton;
    DataInicialEdit: TcxDateEdit;
    DataFinalEdit: TcxDateEdit;
    CodigoBox: TGroupBox;
    Label3: TLabel;
    Label4: TLabel;
    CodInicialEdit: TNumberBox;
    CodFinalEdit: TNumberBox;
    Button2: TButton;
    BuscarBtn: TBitBtn;
    MostrarTudoBtn: TButton;
    ImageList1: TImageList;
    procedure DataInicialEditClick(Sender: TObject);
    procedure DataFinalEditDblClick(Sender: TObject);
    procedure LimparDatasBtnClick(Sender: TObject);
    procedure CodInicialEditClick(Sender: TObject);
    procedure CodFinalEditClick(Sender: TObject);
    procedure CodFinalEditEnter(Sender: TObject);
    procedure Button2Click(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

implementation

{$R *.dfm}

procedure TFiltroDataCod.Button2Click(Sender: TObject);
begin
  CodInicialEdit.Clear;
  CodFinalEdit.Clear;
end;

procedure TFiltroDataCod.CodFinalEditClick(Sender: TObject);
begin
  CodFinalEdit.SetFocus;
  CodFinalEdit.Clear;
end;

procedure TFiltroDataCod.CodFinalEditEnter(Sender: TObject);
begin
  CodFinalEdit.Value := CodInicialEdit.Value;
end;

procedure TFiltroDataCod.CodInicialEditClick(Sender: TObject);
begin
  CodInicialEdit.SetFocus;
  CodInicialEdit.Clear;
end;

procedure TFiltroDataCod.DataFinalEditDblClick(Sender: TObject);
begin
  DataFinalEdit.SetFocus;
end;

procedure TFiltroDataCod.DataInicialEditClick(Sender: TObject);
begin
  DataInicialEdit.SetFocus;
end;

procedure TFiltroDataCod.LimparDatasBtnClick(Sender: TObject);
begin
  DataInicialEdit.Clear;
  DataFinalEdit.Clear;
end;

end.
