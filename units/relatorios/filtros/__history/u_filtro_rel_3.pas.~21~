unit u_filtro_rel_3;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.ExtCtrls, Vcl.StdCtrls, Vcl.Buttons,
  System.ImageList, Vcl.ImgList, Data.DB, MemDS, DBAccess, Uni, frxClass,
  frxDBSet, cxGraphics, cxControls, cxLookAndFeels, cxLookAndFeelPainters,
  cxStyles, cxCustomData, cxFilter, cxData, cxDataStorage, cxEdit, cxNavigator,
  dxDateRanges, dxScrollbarAnnotations, cxDBData, fr_estilo, cxGridLevel,
  cxGridCustomTableView, cxGridTableView, cxGridDBTableView, cxClasses,
  cxGridCustomView, cxGrid, Generics.Collections;

type
  TFormRel3 = class(TForm)
    pn_button: TPanel;
    RelBtn: TBitBtn;
    ImageList1: TImageList;
    rel_3: TfrxReport;
    db_rel_3: TfrxDBDataset;
    ds_rel_3: TDataSource;
    LimparProd: TBitBtn;
    BuscaProdutoBtn: TSpeedButton;
    CodProdEdit: TEdit;
    Label2: TLabel;
    qRel3: TUniQuery;
    procedure RelBtnClick(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  FormRel3: TFormRel3;

implementation

{$R *.dfm}

uses u_dm1, u_buscaProduto, u_controleForm;

procedure TFormRel3.RelBtnClick(Sender: TObject);
var
  xWhere: String;

begin

  xWhere := '';

  if CodProdEdit.Text <> '' then
  begin
    xWhere := xWhere + 'and prod_codigo in (' + CodProdEdit.Text + ')';
  end;

  if CodProdEdit.Text = '' then
  begin
    if not Confirma('Você não especificou nenhum produto, a consulta irá retornar todos os registros, deseja continuar?') then
    begin
      Exit;
    end;
  end;

  qRel3.SQL.Clear;
  qRel3.SQL.Add('select prod_codigo, prod_descricao, sum(lote_quantidade) as qtd_total');
  qRel3.SQL.Add('from tb_produtos');
  qRel3.SQL.Add('left join tb_lotes on lote_produto = prod_codigo');
  qRel3.SQL.Add('where 1 = 1 ' + xWhere);
  qRel3.SQL.Add('group by prod_codigo, prod_descricao');
  qRel3.SQL.Add('order by prod_codigo');

  qRel3.Open;
  rel_3.ShowReport;
  qRel3.Close;

end;

end.
