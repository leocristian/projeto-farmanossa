unit u_filtro_rel_3;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.ExtCtrls, Vcl.StdCtrls, Vcl.Buttons,
  System.ImageList, Vcl.ImgList, Data.DB, MemDS, DBAccess, Uni, frxClass,
  frxDBSet;

type
  TFormRel3 = class(TForm)
    pn_form: TPanel;
    DescProdEdit: TEdit;
    LimparProd: TBitBtn;
    BuscaProdutoBtn: TSpeedButton;
    CodProdEdit: TEdit;
    Label2: TLabel;
    RelBtn: TBitBtn;
    ImageList1: TImageList;
    rel_3: TfrxReport;
    db_rel_3: TfrxDBDataset;
    tb_rel_3: TUniTable;
    ds_rel_3: TDataSource;
    procedure CodProdEditExit(Sender: TObject);
    procedure LimparProdClick(Sender: TObject);
    procedure BuscaProdutoBtnClick(Sender: TObject);
    procedure RelBtnClick(Sender: TObject);
    procedure CodProdEditClick(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  FormRel3: TFormRel3;

implementation

{$R *.dfm}

uses u_dm1, u_buscaProduto;

procedure TFormRel3.BuscaProdutoBtnClick(Sender: TObject);
begin
  BuscaProdutoForm.FrameButtons1.ModoEdit.Text := 'R3';
  BuscaProdutoForm.Show;
end;

procedure TFormRel3.CodProdEditClick(Sender: TObject);
begin
  CodProdEdit.SetFocus;
end;

procedure TFormRel3.CodProdEditExit(Sender: TObject);
var
  q1: TUniQuery;

begin

  if CodProdEdit.text = '' then Exit;

  DescProdEdit.Clear;

  try
    q1 := TUniQuery.Create(q1);
    q1.Connection := dm1.con1;

    q1.SQL.Text := 'select prod_descricao from tb_produtos where prod_codigo = :codigo';
    q1.ParamByName('codigo').Value := CodProdEdit.Text;

    q1.Open;

    if q1.RecordCount = 1 then
    begin
      DescProdEdit.Text := q1.FieldByName('prod_descricao').Value;
      RelBtn.SetFocus;
    end
    else
    begin
      CodProdEdit.Clear;
      CodProdEdit.SetFocus;
    end;

  finally
    q1.Close;
    FreeAndNil(q1);
  end;
end;

procedure TFormRel3.LimparProdClick(Sender: TObject);
begin
  CodProdEdit.Clear;
  DescProdEdit.Clear;
end;

procedure TFormRel3.RelBtnClick(Sender: TObject);
begin
  tb_rel_3.Close;
  tb_rel_3.Connection := dm1.con1;

  tb_rel_3.SQL.Clear;
  tb_rel_3.SQL.Add('select prod_codigo, prod_descricao, lote_codigo, lote_dtfabricacao, lote_dtvencimento, lote_quantidade');
  tb_rel_3.SQL.Add('from tb_produtos');
  tb_rel_3.SQL.Add('inner join tb_lotes on lote_produto = prod_codigo');

  ds_rel_3.DataSet := tb_rel_3;
  tb_rel_3.Open;
  rel_3.ShowReport;
  tb_rel_3.Close;
end;

end.
