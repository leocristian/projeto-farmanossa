unit u_filtro_rel_2;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.ExtCtrls, Vcl.StdCtrls, Vcl.Buttons,
  System.ImageList, Vcl.ImgList, cxGraphics, cxControls, cxLookAndFeels,
  cxLookAndFeelPainters, cxStyles, cxCustomData, cxFilter, cxData,
  cxDataStorage, cxEdit, cxNavigator, dxDateRanges, dxScrollbarAnnotations,
  Data.DB, cxDBData, cxGridLevel, cxClasses, cxGridCustomView,
  cxGridCustomTableView, cxGridTableView, cxGridDBTableView, cxGrid, MemDS,
  VirtualTable, fr_estilo, DBAccess, Uni, frxClass, frxDBSet, Generics.Collections,
  u_selecionaProdutos;

type
  TFormRel2 = class(TForm)
    pn_button: TPanel;
    Rel1Btn: TBitBtn;
    ImageList1: TImageList;
    rel_2: TfrxReport;
    db_rel_2: TfrxDBDataset;
    ds_rel_2: TDataSource;
    Label2: TLabel;
    CodProdEdit: TEdit;
    BuscaProdutoBtn: TSpeedButton;
    LimparProd: TBitBtn;
    qRel2: TUniQuery;
    procedure Rel1BtnClick(Sender: TObject);
    procedure BuscaProdutoBtnClick(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  FormRel2: TFormRel2;

implementation

{$R *.dfm}

uses u_controleForm, u_dm1;

procedure TFormRel2.BuscaProdutoBtnClick(Sender: TObject);
begin
  SelecionaProdutosForm.ModoEdit.Text := 'R2';
  SelecionaProdutosForm.Show;
end;

procedure TFormRel2.Rel1BtnClick(Sender: TObject);
var
  xWhere: String;

begin

  xWhere := '';

  if CodProdEdit.Text <> '' then
  begin
    xWhere := xWhere + 'and prod_codigo in (' + CodProdEdit.Text + ')';
  end;

  if CodProdEdit.Text = '' then
  begin
    if not Confirma('Você não especificou nenhum produto, a consulta irá retornar todos os registros, deseja continuar?') then
    begin
      Exit;
    end;
  end;

  qRel2.SQL.Clear;
  qRel2.SQL.Add('select prod_codigo, prod_descricao, sum(lote_quantidade) as qtd_total');
  qRel2.SQL.Add('from tb_produtos');
  qRel2.SQL.Add('left join tb_lotes on lote_produto = prod_codigo');
  qRel2.SQL.Add('where 1 = 1 ' + xWhere);
  qRel2.SQL.Add('group by prod_codigo, prod_descricao');
  qRel2.SQL.Add('order by prod_codigo');

  ds_rel_2.DataSet := qRel2;

  qRel2.Open;
  rel_2.ShowReport;
  qRel2.Close;

end;

end.
