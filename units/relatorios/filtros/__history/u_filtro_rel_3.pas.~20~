implementation

{$R *.dfm}

uses u_dm1, u_buscaProduto, u_controleForm;

procedure TFormRel3.RelBtnClick(Sender: TObject);
var
  listaCod: TList<Integer>;
  codSelecionado, indexSelecionado, i, count: Integer;

begin
  if grid_produtosDBTableView1.Controller.SelectedRowCount = 0 then
  begin
    Aviso('Selecione os produtos para gerar o relatório!');
    Exit;
  end;

  listaCod := TList<Integer>.Create;

  for i := 0 to grid_produtosDBTableView1.Controller.SelectedRowCount - 1 do
  begin
    indexSelecionado := grid_produtosDBTableView1.DataController.GetSelectedRowIndex(i);
    codSelecionado := grid_produtosDBTableView1.ViewData.Records[indexSelecionado].Values[0];
    listaCod.Add(codSelecionado);
  end;

//  grid_produtosDBTableView1.Controller.SelectedRows['prod_codigo'];

  tb_rel_3.Close;
  tb_rel_3.Connection := dm1.con1;

  tb_rel_3.SQL.Clear;
  tb_rel_3.SQL.Add('select prod_codigo, prod_descricao, lote_codigo, lote_dtfabricacao, lote_dtvencimento, lote_quantidade');
  tb_rel_3.SQL.Add('from tb_produtos');
  tb_rel_3.SQL.Add('inner join tb_lotes on lote_produto = prod_codigo');
  tb_rel_3.SQL.Add('where prod_codigo in (');

  count := 0;
  for i in listaCod do
  begin
    if count = listaCod.Count-1 then
    begin
      tb_rel_3.SQL.Add(i.ToString);
    end
    else
    begin
      tb_rel_3.SQL.Add(i.ToString + ',');
    end;
    count := count + 1;
  end;

  tb_rel_3.SQL.Add(')');
  tb_rel_3.SQL.Add('order by prod_codigo, lote_dtvencimento');

  ds_rel_3.DataSet := tb_rel_3;
  tb_rel_3.Open;
  rel_3.ShowReport;
  tb_rel_3.Close;

  FreeAndNil(listaCod);
end;

end.
