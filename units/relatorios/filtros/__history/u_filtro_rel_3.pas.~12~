unit u_filtro_rel_3;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.ExtCtrls, Vcl.StdCtrls, Vcl.Buttons,
  System.ImageList, Vcl.ImgList, Data.DB, MemDS, DBAccess, Uni, frxClass,
  frxDBSet, cxGraphics, cxControls, cxLookAndFeels, cxLookAndFeelPainters,
  cxStyles, cxCustomData, cxFilter, cxData, cxDataStorage, cxEdit, cxNavigator,
  dxDateRanges, dxScrollbarAnnotations, cxDBData, fr_estilo, cxGridLevel,
  cxGridCustomTableView, cxGridTableView, cxGridDBTableView, cxClasses,
  cxGridCustomView, cxGrid, Generics.Collections;

type
  TFormRel3 = class(TForm)
    pn_button: TPanel;
    RelBtn: TBitBtn;
    CheckBox1: TCheckBox;
    pn_buscaProd: TPanel;
    Label1: TLabel;
    grid_produtos: TcxGrid;
    grid_produtosDBTableView1: TcxGridDBTableView;
    prod_codigo: TcxGridDBColumn;
    prod_descricao: TcxGridDBColumn;
    grid_produtosLevel1: TcxGridLevel;
    FrameGrid1: TFrameGrid;
    ImageList1: TImageList;
    ds_produtos: TDataSource;
    tb_produtos: TUniTable;
    rel_3: TfrxReport;
    db_rel_3: TfrxDBDataset;
    tb_rel_3: TUniTable;
    ds_rel_3: TDataSource;
    procedure FormShow(Sender: TObject);
    procedure RelBtnClick(Sender: TObject);
    procedure CheckBox1Click(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  FormRel3: TFormRel3;

implementation

{$R *.dfm}

uses u_dm1, u_buscaProduto, u_controleForm;

procedure TFormRel3.CheckBox1Click(Sender: TObject);
begin
  if CheckBox1.Checked then
  begin
    grid_produtosDBTableView1.DataController.SelectAll
  end
  else
  begin
    grid_produtosDBTableView1.DataController.ClearSelection;
  end;
end;

procedure TFormRel3.FormShow(Sender: TObject);
begin
  tb_produtos.Close;
  tb_produtos.Connection := dm1.con1;

  tb_produtos.SQL.Add('select distinct prod_codigo, prod_descricao from tb_produtos ');
  tb_produtos.SQL.Add('inner join tb_lotes on lote_produto = prod_codigo');
  tb_produtos.SQL.Add('order by prod_codigo');

  tb_produtos.Open;

  ds_produtos.DataSet := tb_produtos;
  tb_produtos.Open;
end;

procedure TFormRel3.RelBtnClick(Sender: TObject);
var
  listaCod: TList<Integer>;
  codSelecionado, indexSelecionado, i, count: Integer;

begin
  if grid_produtosDBTableView1.Controller.SelectedRowCount = 0 then
  begin
    Aviso('Selecione os produtos para gerar o relatório!');
    Exit;
  end;

  listaCod := TList<Integer>.Create;

  for i := 0 to grid_produtosDBTableView1.Controller.SelectedRowCount - 1 do
  begin
    indexSelecionado := grid_produtosDBTableView1.DataController.GetSelectedRowIndex(i);
    codSelecionado := grid_produtosDBTableView1.ViewData.Records[indexSelecionado].Values[0];
    listaCod.Add(codSelecionado);
  end;

//  grid_produtosDBTableView1.Controller.SelectedRows['prod_codigo'];

  tb_rel_3.Close;
  tb_rel_3.Connection := dm1.con1;

  tb_rel_3.SQL.Clear;
  tb_rel_3.SQL.Add('select prod_codigo, prod_descricao, lote_codigo, lote_dtfabricacao, lote_dtvencimento, lote_quantidade');
  tb_rel_3.SQL.Add('from tb_produtos');
  tb_rel_3.SQL.Add('inner join tb_lotes on lote_produto = prod_codigo');
  tb_rel_3.SQL.Add('where prod_codigo in (');

  count := 0;
  for i in listaCod do
  begin
    if count = listaCod.Count-1 then
    begin
      tb_rel_3.SQL.Add(i.ToString);
    end
    else
    begin
      tb_rel_3.SQL.Add(i.ToString + ',');
    end;
    count := count + 1;
  end;

  tb_rel_3.SQL.Add(')');

  ds_rel_3.DataSet := tb_rel_3;
  tb_rel_3.Open;
  rel_3.ShowReport;
  tb_rel_3.Close;

  FreeAndNil(listaCod);
end;

end.
