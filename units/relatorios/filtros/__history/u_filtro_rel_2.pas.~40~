unit u_filtro_rel_2;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.ExtCtrls, Vcl.StdCtrls, Vcl.Buttons,
  System.ImageList, Vcl.ImgList, cxGraphics, cxControls, cxLookAndFeels,
  cxLookAndFeelPainters, cxStyles, cxCustomData, cxFilter, cxData,
  cxDataStorage, cxEdit, cxNavigator, dxDateRanges, dxScrollbarAnnotations,
  Data.DB, cxDBData, cxGridLevel, cxClasses, cxGridCustomView,
  cxGridCustomTableView, cxGridTableView, cxGridDBTableView, cxGrid, MemDS,
  VirtualTable, fr_estilo, DBAccess, Uni, frxClass, frxDBSet, Generics.Collections;

type
  TFormRel2 = class(TForm)
    pn_button: TPanel;
    Rel1Btn: TBitBtn;
    pn_buscaProd: TPanel;
    ImageList1: TImageList;
    grid_produtosDBTableView1: TcxGridDBTableView;
    grid_produtosLevel1: TcxGridLevel;
    grid_produtos: TcxGrid;
    ds_produtos: TDataSource;
    prod_codigo: TcxGridDBColumn;
    prod_descricao: TcxGridDBColumn;
    FrameGrid1: TFrameGrid;
    Label1: TLabel;
    CheckBox1: TCheckBox;
    tb_produtos: TUniTable;
    rel_2: TfrxReport;
    db_rel_2: TfrxDBDataset;
    tb_rel_2: TUniTable;
    ds_rel_2: TDataSource;
    procedure FormShow(Sender: TObject);
    procedure CheckBox1Click(Sender: TObject);
    procedure Rel1BtnClick(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  FormRel2: TFormRel2;

implementation

{$R *.dfm}

uses u_controleForm, u_dm1;

procedure TFormRel2.CheckBox1Click(Sender: TObject);
begin
  if CheckBox1.Checked then
  begin
    grid_produtosDBTableView1.DataController.SelectAll
  end
  else
  begin
    grid_produtosDBTableView1.DataController.ClearSelection;
  end;
end;

procedure TFormRel2.FormShow(Sender: TObject);
begin
  tb_produtos.Close;
  tb_produtos.Connection := dm1.con1;

  tb_produtos.SQL.Text := 'select prod_codigo, prod_descricao from tb_produtos order by prod_codigo';
  tb_produtos.Open;

  ds_produtos.DataSet := tb_produtos;
  tb_produtos.Open;
end;

procedure TFormRel2.Rel1BtnClick(Sender: TObject);
var
  listaCod: TList<Integer>;
  codSelecionado, indexSelecionado, i, count: Integer;

begin
  if grid_produtosDBTableView1.Controller.SelectedRowCount = 0 then
  begin
    Aviso('Selecione os produtos para gerar o relatório!');
    Exit;
  end;

  listaCod := TList<Integer>.Create;

  for i := 0 to grid_produtosDBTableView1.Controller.SelectedRowCount - 1 do
  begin
    indexSelecionado := grid_produtosDBTableView1.DataController.GetSelectedRowIndex(i);
    codSelecionado := grid_produtosDBTableView1.ViewData.Records[indexSelecionado].Values[0];
    listaCod.Add(codSelecionado);
  end;

//  grid_produtosDBTableView1.Controller.SelectedRows['prod_codigo'];

  tb_rel_2.Close;
  tb_rel_2.Connection := dm1.con1;

  tb_rel_2.SQL.Clear;
  tb_rel_2.SQL.Add('select prod_codigo, prod_descricao, sum(lote_quantidade) as qtd_total');
  tb_rel_2.SQL.Add('from tb_produtos');
  tb_rel_2.SQL.Add('inner join tb_lotes on lote_produto = prod_codigo');

  tb_rel_2.SQL.Add('where prod_codigo in (');

  aviso(listaCod.Count.ToString);
  count := 0;
  for i in listaCod do
  begin
    if count = listaCod.Count then
    begin
      tb_rel_2.SQL.Add(i.ToString);
      Exit;
    end
    else
    begin
      tb_rel_2.SQL.Add(i.ToString + ',');
    end;
  end;

  tb_rel_2.SQL.Add(')');
  tb_rel_2.SQL.Add('group by prod_codigo, prod_descricao');

//  Aviso(tb_rel_2.SQL.Text);
  ds_rel_2.DataSet := tb_rel_2;

  tb_rel_2.Open;
  rel_2.ShowReport;
  tb_rel_2.Close;
end;

end.
