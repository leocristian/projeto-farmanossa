unit u_selecionarLocais;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.ExtCtrls, cxGraphics,
  cxControls, cxLookAndFeels, cxLookAndFeelPainters, cxStyles, cxCustomData,
  cxFilter, cxData, cxDataStorage, cxEdit, cxNavigator, dxDateRanges,
  dxScrollbarAnnotations, Data.DB, cxDBData, cxGridLevel, cxGridCustomTableView,
  cxGridTableView, cxGridDBTableView, cxClasses, cxGridCustomView, cxGrid,
  Vcl.Buttons, fr_estilo, MemDS, DBAccess, Uni;

type
  TSelecionarLotesForm = class(TForm)
    pn_buscaProd: TPanel;
    Label1: TLabel;
    grid_lotes: TcxGrid;
    grid_lotesDBTableView1: TcxGridDBTableView;
    loc_codigo: TcxGridDBColumn;
    loc_descricao: TcxGridDBColumn;
    grid_lotesLevel1: TcxGridLevel;
    pn_button: TPanel;
    RelBtn: TBitBtn;
    CheckBox1: TCheckBox;
    FrameGrid1: TFrameGrid;
    tb_locais: TUniTable;
    ds_locais: TDataSource;
    procedure CheckBox1Click(Sender: TObject);
    procedure FormShow(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  SelecionarLotesForm: TSelecionarLotesForm;

implementation

{$R *.dfm}

uses u_dm1;

procedure TSelecionarLotesForm.CheckBox1Click(Sender: TObject);
begin
  if CheckBox1.Checked then
  begin
    grid_lotesDBTableView1.DataController.SelectAll
  end
  else
  begin
    grid_lotesDBTableView1.DataController.ClearSelection;
  end;
end;

procedure TSelecionarLotesForm.FormShow(Sender: TObject);
begin
  tb_lotes.Close;
  tb_lotes.Connection := dm1.con1;

  tb_lotes.SQL.Clear;
  tb_lotes.SQL.Add('select distinct loc_codigo, loc_descricao from tb_locais_estoque ');
  tb_lotes.SQL.Add('inner join tb_lotes on lote_local = loc_codigo');
  tb_lotes.SQL.Add('order by loc_codigo');

  ds_locais.DataSet := tb_lotes;
  tb_lotes.Open;

  grid_locaisDBTableView1.DataController.ClearSelection;
  Checkbox1.Checked := False;
end;

end.
