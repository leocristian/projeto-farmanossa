unit u_relatorios;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.Imaging.pngimage, Vcl.ExtCtrls,
  Vcl.StdCtrls, cxGraphics, cxControls, cxLookAndFeels, cxLookAndFeelPainters,
  dxListView, cxStyles, dxScrollbarAnnotations, cxEdit, cxVGrid,
  cxInplaceContainer, Vcl.CategoryButtons, cxCustomData, cxFilter, cxData,
  cxDataStorage, cxNavigator, dxDateRanges, Data.DB, cxDBData,
  cxGridCustomTableView, cxGridTableView, cxGridDBTableView, cxGridLevel,
  cxClasses, cxGridCustomView, cxGrid, MemDS, VirtualTable, Vcl.ComCtrls,
  frxClass, frxDBSet, DBAccess, Uni, System.ImageList, Vcl.ImgList, Vcl.Buttons;

type
  TPagRelatorios = class(TForm)
    pn_cabecalho: TPanel;
    Label1: TLabel;
    Image1: TImage;
    pn_busca: TPanel;
    RelBox: TComboBox;
    Label2: TLabel;
    pn_relatorio: TPanel;
    SpeedButton1: TSpeedButton;
    ImageList1: TImageList;
    procedure RelBoxChange(Sender: TObject);
    procedure FormShow(Sender: TObject);
    procedure FormKeyPress(Sender: TObject; var Key: Char);
    procedure SpeedButton1Click(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  PagRelatorios: TPagRelatorios;

implementation

{$R *.dfm}

uses u_filtro_rel_1, u_dm1, u_filtro_rel_2, u_filtro_rel_3, u_filtro_rel_4;

procedure TPagRelatorios.FormKeyPress(Sender: TObject; var Key: Char);
begin
  if Key = #13 then
  begin
    Key := #0;
    Perform(wm_nextdlgctl, 0, 0);
  end
  else if key = #27 then close
end;

procedure TPagRelatorios.FormShow(Sender: TObject);
begin
  RelBox.ItemIndex :=  0;
  FormRel1.Parent := pn_relatorio;
  FormRel1.Show;
end;

procedure TPagRelatorios.RelBoxChange(Sender: TObject);
begin
  if RelBox.ItemIndex = 0 then
  begin
    FormRel1.Parent := pn_relatorio;
    FormRel1.Show;
    FormRel1.LimparProdClick(Sender);
    FormRel1.LimparLocalClick(Sender);
  end
  else if RelBox.ItemIndex = 1 then
  begin
    FormRel2.Parent := pn_relatorio;
    FormRel2.Show;
  end
  else if RelBox.ItemIndex = 2 then
  begin
    FormRel3.Parent := pn_relatorio;
    FormRel3.Show;
  end
  else if RelBox.ItemIndex = 3 then
  begin
    FormRel4.Parent := pn_relatorio;
    FormRel4.Show;
    FormRel4.LimparProdClick(Sender);
    FormRel4.LimparLocalClick(Sender);
  end;
end;

procedure TPagRelatorios.SpeedButton1Click(Sender: TObject);
begin
  Close;
end;

end.
