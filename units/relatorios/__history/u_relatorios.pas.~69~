unit u_relatorios;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.Imaging.pngimage, Vcl.ExtCtrls,
  Vcl.StdCtrls, cxGraphics, cxControls, cxLookAndFeels, cxLookAndFeelPainters,
  dxListView, cxStyles, dxScrollbarAnnotations, cxEdit, cxVGrid,
  cxInplaceContainer, Vcl.CategoryButtons, cxCustomData, cxFilter, cxData,
  cxDataStorage, cxNavigator, dxDateRanges, Data.DB, cxDBData,
  cxGridCustomTableView, cxGridTableView, cxGridDBTableView, cxGridLevel,
  cxClasses, cxGridCustomView, cxGrid, MemDS, VirtualTable, Vcl.ComCtrls,
  frxClass, frxDBSet, DBAccess, Uni;

type
  TPagRelatorios = class(TForm)
    pn_cabecalho: TPanel;
    Label1: TLabel;
    Image1: TImage;
    pn_busca: TPanel;
    RelBox: TComboBox;
    Label2: TLabel;
    pn_relatorio: TPanel;
    rel_3: TfrxReport;
    db_rel_3: TfrxDBDataset;
    rel_4: TfrxReport;
    db_rel_4: TfrxDBDataset;
    tb_rel_3: TUniTable;
    ds_rel_3: TDataSource;
    tb_rel_4: TUniTable;
    ds_rel_4: TDataSource;
    procedure RelBoxChange(Sender: TObject);
    procedure FormShow(Sender: TObject);
    procedure FormKeyPress(Sender: TObject; var Key: Char);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  PagRelatorios: TPagRelatorios;

implementation

{$R *.dfm}

uses u_filtro_rel_1, u_dm1, u_filtro_rel_2;

procedure TPagRelatorios.FormKeyPress(Sender: TObject; var Key: Char);
begin
  if Key = #13 then
  begin
    Key := #0;
    Perform(wm_nextdlgctl, 0, 0);
  end
  else if key = #27 then close
end;

procedure TPagRelatorios.FormShow(Sender: TObject);
begin
  RelBox.ItemIndex :=  0;
  FormRel1.Parent := pn_relatorio;
  FormRel1.Show;
end;

procedure TPagRelatorios.RelBoxChange(Sender: TObject);
begin
  if RelBox.ItemIndex = 0 then
  begin
    FormRel1.Parent := pn_relatorio;
    FormRel1.Show;
  end
  else if RelBox.ItemIndex = 1 then
  begin
    FormRel2.Parent := pn_relatorio;
    FormRel2.Show;
  end
  else if RelBox.ItemIndex = 2 then
  begin
    tb_rel_3.Close;
    tb_rel_3.Connection := dm1.con1;

    tb_rel_3.SQL.Clear;
    tb_rel_3.SQL.Add('select prod_codigo, prod_descricao, lote_codigo, lote_dtfabricacao, lote_dtvencimento, lote_quantidade');
    tb_rel_3.SQL.Add('from tb_produtos');
    tb_rel_3.SQL.Add('inner join tb_lotes on lote_produto = prod_codigo');

    ds_rel_3.DataSet := tb_rel_3;
    tb_rel_3.Open;
    rel_3.ShowReport;
    tb_rel_3.Close;
  end
  else if RelBox.ItemIndex = 3 then
  begin
    tb_rel_4.Close;
    tb_rel_4.Connection := dm1.con1;

    tb_rel_4.SQL.Clear;
    tb_rel_4.SQL.Add('select loc_codigo, loc_descricao, prod_codigo, prod_descricao, lote_codigo, lote_dtfabricacao, lote_dtvencimento, lote_quantidade');
    tb_rel_4.SQL.Add('from tb_produtos');
    tb_rel_4.SQL.Add('inner join tb_lotes on lote_produto = prod_codigo');
    tb_rel_4.SQL.Add('inner join tb_locais_estoque on lote_local = loc_codigo');

    ds_rel_4.DataSet := tb_rel_4;
    tb_rel_4.Open;
    rel_4.ShowReport;
    tb_rel_4.Close;
  end;
end;

end.
