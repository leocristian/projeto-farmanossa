unit u_selecionarLocais;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.ExtCtrls, cxGraphics,
  cxControls, cxLookAndFeels, cxLookAndFeelPainters, cxStyles, cxCustomData,
  cxFilter, cxData, cxDataStorage, cxEdit, cxNavigator, dxDateRanges,
  dxScrollbarAnnotations, Data.DB, cxDBData, cxGridLevel, cxGridCustomTableView,
  cxGridTableView, cxGridDBTableView, cxClasses, cxGridCustomView, cxGrid,
  Vcl.Buttons, fr_estilo, MemDS, DBAccess, Uni, Generics.Collections,
  VirtualTable, u_estoque;

type
  TSelecionarLocaisForm = class(TForm)
    pn_buscaProd: TPanel;
    Label1: TLabel;
    grid_locais: TcxGrid;
    grid_locaisDBTableView1: TcxGridDBTableView;
    grid_locaisLevel1: TcxGridLevel;
    pn_button: TPanel;
    RelBtn: TBitBtn;
    CheckBox1: TCheckBox;
    FrameGrid1: TFrameGrid;
    ds_locais: TDataSource;
    ModoEdit: TEdit;
    loc_selec: TcxGridDBColumn;
    loc_descricao: TcxGridDBColumn;
    vt_locais: TVirtualTable;
    grid_locaisDBTableView1Column1: TcxGridDBColumn;
    procedure CheckBox1Click(Sender: TObject);
    procedure FormShow(Sender: TObject);
    procedure RelBtnClick(Sender: TObject);
    procedure grid_locaisDBTableView1CellClick(Sender: TcxCustomGridTableView;
      ACellViewInfo: TcxGridTableDataCellViewInfo; AButton: TMouseButton;
      AShift: TShiftState; var AHandled: Boolean);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  SelecionarLocaisForm: TSelecionarLocaisForm;

implementation

{$R *.dfm}

uses u_dm1, u_controleForm, u_filtro_rel_1, u_filtro_rel_4;

procedure TSelecionarLocaisForm.CheckBox1Click(Sender: TObject);
begin
  if CheckBox1.Checked then
  begin
    vt_locais.First;
    while not vt_locais.Eof do
    begin
      ds_locais.Edit;
      vt_locais.FieldByName('loc_selec').Value := True;
      vt_locais.Next;
    end;
  end
  else
  begin
    vt_locais.First;
    while not vt_locais.Eof do
    begin
      ds_locais.Edit;
      vt_locais.FieldByName('loc_selec').Value := False;
      vt_locais.Next;
    end;
  end;
end;

procedure TSelecionarLocaisForm.FormShow(Sender: TObject);
begin

  dm1.q1.SQL.Clear;
  dm1.q1.SQL.Add('select distinct loc_codigo, loc_descricao from tb_locais_estoque ');
  dm1.q1.SQL.Add('left join tb_lotes on lote_local = loc_codigo');
  dm1.q1.SQL.Add('order by loc_codigo');

  dm1.q1.Open;

  dm1.q1.First;

  vt_locais.Open;
  vt_locais.Clear;

  while not dm1.q1.Eof do
  begin
    vt_locais.Append;
    vt_locais.FieldByName('loc_selec').Value := False;
    vt_locais.FieldByName('loc_codigo').Value := dm1.q1.FieldByName('loc_codigo').AsInteger;
    vt_locais.FieldByName('loc_descricao').Value := dm1.q1.FieldByName('loc_descricao').AsString;
    dm1.q1.Next;
  end;

  vt_locais.Open;
  Checkbox1.Checked := False;
end;

procedure TSelecionarLocaisForm.grid_locaisDBTableView1CellClick(
  Sender: TcxCustomGridTableView; ACellViewInfo: TcxGridTableDataCellViewInfo;
  AButton: TMouseButton; AShift: TShiftState; var AHandled: Boolean);
begin
  ds_locais.Edit;

  if vt_locais.FieldByName('loc_selec').AsBoolean then
  begin
    vt_locais.FieldByName('loc_selec').Value := False;
  end
  else
  begin
    vt_locais.FieldByName('loc_selec').Value := True;
  end;
end;

procedure TSelecionarLocaisForm.RelBtnClick(Sender: TObject);
var
  listaCod: TList<Integer>;
  codSelecionado, indexSelecionado, i, count: Integer;
  codigos: String;

begin

  {
    codigos := '';

     vt1.First;
     while not vt1.Eof do
     begin

        if vt1.FieldByName('selec').AsBoolean then
        begin
          if codigos='' then
          begin
            codigos := vt1.FieldByName('codigo').AsString;
          end else
          begin
            codigos := codigos +','+ vt1.FieldByName('codigo').AsString;
          end;
        end;

       vt1.Next;
     end;

    if codigos='' then
    begin
      Aviso('Selecione os locais de estoque para gerar o relatório!');
      Exit;
    end;
  }
  vt_locais.First;
  while not vt_locais.Eof do
  begin
    showmessage(vt_locais.FieldByName('loc_selec').Value);
    vt_locais.Next;
  end;
  if grid_locaisDBTableView1.Controller.SelectedRowCount = 0 then
  begin
    Aviso('Selecione os locais de estoque para gerar o relatório!');
    Exit;
  end;

  listaCod := TList<Integer>.Create;

  for i := 0 to grid_locaisDBTableView1.Controller.SelectedRowCount - 1 do
  begin
    indexSelecionado := grid_locaisDBTableView1.DataController.GetSelectedRowIndex(i);
    codSelecionado := grid_locaisDBTableView1.ViewData.Records[indexSelecionado].Values[0];
    listaCod.Add(codSelecionado);
  end;

  count := 0;
  for i in listaCod do
  begin
    if count = listaCod.Count-1 then
    begin
      codigos := codigos + i.ToString;
    end
    else
    begin
      codigos := codigos + i.ToString + ',';
    end;
    count := count + 1;
  end;

  if ModoEdit.Text = 'R1' then
  begin
    FormRel1.CodLocalEdit.Text := codigos;
  end
  else if ModoEdit.Text = 'R4' then
  begin
    FormRel4.CodLocalEdit.Text := codigos;
  end
  else if ModoEdit.Text = 'E' then
  begin
    PagEstoque.CodLocalEdit.Text := codigos;
  end;

  close;
  FreeAndNil(listaCod);
end;

end.
