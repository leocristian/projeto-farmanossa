    Label3: TLabel;
    BitBtn1: TBitBtn;
    ImageList1: TImageList;
    ds_estoque: TDataSource;
    prod_codigo: TcxGridDBColumn;
    prod_descricao: TcxGridDBColumn;
    popup_produtos: TPopupMenu;
    LotesProduto: TMenuItem;
    prod_status: TcxGridDBColumn;
    loc_codigo: TcxGridDBColumn;
    loc_descricao: TcxGridDBColumn;
