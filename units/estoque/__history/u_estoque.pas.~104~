    procedure BuscaProdutoBtnClick(Sender: TObject);
    procedure SpeedButton2Click(Sender: TObject);
    procedure LimparProdClick(Sender: TObject);
    procedure BuscaLocalBtnClick(Sender: TObject);
    procedure LimparLocalClick(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  PagEstoque: TPagEstoque;

implementation

{$R *.dfm}

uses u_dm1, u_lotesProduto, u_selecionaProdutos, u_selecionarLocais;

procedure TPagEstoque.BitBtn1Click(Sender: TObject);
begin

  tb_estoque.Close;
  tb_estoque.Connection := dm1.con1;

  tb_estoque.SQL.Clear;

  tb_estoque.SQL.Add('select * from (');
  tb_estoque.SQL.Add('select prod_codigo, prod_descricao, prod_status, loc_codigo, loc_descricao, sum(lote_quantidade) as qtd_estoque');
  tb_estoque.SQL.Add(' from tb_produtos as p');
  tb_estoque.SQL.Add('inner join tb_lotes as l ');
  tb_estoque.SQL.Add('on l.lote_produto = p.prod_codigo');
  tb_estoque.SQL.Add('inner join tb_locais_estoque as locais');
  tb_estoque.SQL.Add('on locais.loc_codigo = l.lote_local');
  tb_estoque.SQL.Add('group by prod_codigo, prod_descricao, prod_status, loc_codigo, loc_descricao) as result');

  // Manipular a quantidade do produto
  if QuantidadeBox.ItemIndex = 0 then
  begin
    tb_estoque.SQL.Add('where :qtd=:qtd');
    QuantidadeEdit.Value := 1;
  end
  else if QuantidadeBox.ItemIndex = 1 then
  begin
    tb_estoque.SQL.Add('where result.qtd_estoque != :qtd');
    QuantidadeEdit.Value := 0;
  end
  else if QuantidadeBox.ItemIndex = 2 then
  begin
    tb_estoque.SQL.Add('where result.qtd_estoque > :qtd');
  end
  else if QuantidadeBox.ItemIndex = 3 then
  begin
   tb_estoque.SQL.Add('where result.qtd_estoque < :qtd');
  end
  else if QuantidadeBox.ItemIndex = 4 then
  begin
   tb_estoque.SQL.Add('where result.qtd_estoque = :qtd');
  end;

  tb_estoque.ParamByName('qtd').Value := QuantidadeEdit.Text;

  if CodProdEdit.Text <> '' then
  begin
    tb_estoque.SQl.Add('and result.prod_codigo in (' + CodProdEdit.Text + ')');
  end;

  if CodLocalEdit.Text <> '' then
  begin
    tb_estoque.SQL.Add('and result.loc_codigo in (' + CodLocalEdit.Text + ')');
  end;

  if TipoProdutoBox.ItemIndex = 0 then
  begin
    tb_estoque.SQL.Add('and result.prod_status in (''ATIVO'', ''INATIVO'')');
  end
  else if TipoProdutoBox.ItemIndex = 1 then
  begin
    tb_estoque.SQL.Add('and result.prod_status = ''ATIVO''');
  end
  else if TipoProdutoBox.ItemIndex = 2 then
  begin
    tb_estoque.SQL.Add('and result.prod_status  = ''INATIVO''');
  end;

  ds_estoque.DataSet := tb_estoque;
  tb_estoque.Open;

end;

procedure TPagEstoque.QuantidadeBoxChange(Sender: TObject);
begin
  if (QuantidadeBox.ItemIndex <> 0) and (QuantidadeBox.ItemIndex <> 1) then
  begin
    QuantidadeEdit.Visible := True;
    QuantidadeEdit.Value := 0;
  end
  else
  begin
    QuantidadeEdit.Visible := False;
  end;
end;

procedure TPagEstoque.QuantidadeEditClick(Sender: TObject);
begin
  QuantidadeEdit.SetFocus;
end;

procedure TPagEstoque.SpeedButton1Click(Sender: TObject);
begin
  CodProdEdit.Clear;
  CodLocalEdit.Clear;
  QuantidadeEdit.Value := 0;
  CodProdEdit.SetFocus;
end;

procedure TPagEstoque.SpeedButton2Click(Sender: TObject);
begin
  Close;
end;

procedure TPagEstoque.BuscaLocalBtnClick(Sender: TObject);
begin
  SelecionarLocaisForm.ModoEdit.Text := 'E';
  SelecionarLocaisForm.Show;
end;

procedure TPagEstoque.BuscaProdutoBtnClick(Sender: TObject);
begin
  SelecionaProdutosForm.ModoEdit.Text := 'E';
  SelecionaProdutosForm.Show;
end;

procedure TPagEstoque.FormClose(Sender: TObject; var Action: TCloseAction);
begin
  tb_estoque.Close;
end;

procedure TPagEstoque.LimparLocalClick(Sender: TObject);
begin
  CodLocalEdit.Clear;
end;

procedure TPagEstoque.LimparProdClick(Sender: TObject);
begin
  CodProdEdit.Clear;
end;

procedure TPagEstoque.LotesProdutoClick(Sender: TObject);
begin
  if not tb_estoque.Active then exit;
  if tb_estoque.RecordCount = 0 then exit;

  LotesProdutoForm.ShowModal;
end;

end.
